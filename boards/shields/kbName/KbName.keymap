#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer: layer_0  {
            bindings = <
                &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3
                &kp NUMBER_4 &kp NUMBER_5 &kp NUMBER_6
                &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9
                &bt BT_CLR &mo 1 
            >;
        };
        alt_layer: layer_1 {
            bindings = <
                /* every key bound here, no &trans needed if you want a fully separate layout */
                &kp Q &kp W &kp E
                &kp A &kp S &kp D
                &kp Z &kp X &kp C
                &bt BT_CLR  &mo 1
            >;
        };
    };
};

/*
&bt BT_CLR_ALL  &kp NUMBER_2    &kp NUMBER_3
                &bt BT_NXT  &bt BT_PRV    &kp NUMBER_6
                &out OUT_USB &out OUT_BLE   &kp NUMBER_9
                &bt BT_CLR  */